# Copy to .env and fill in. Never commit .env.

PORT=3000
NODE_ENV=production
TRUST_PROXY=1                    # 1 behind Nginx / Cloudflare (records real visitor IPs)

# Secret path of the CRM (not linked anywhere on the website). Example: https://abselglobal.com/team-desk/
CRM_PATH=team-desk

# First start only: creates the admin login (10+ characters, letters and numbers).
# You must choose a new password at first sign-in. Remove ADMIN_PASSWORD afterwards.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_NAME=Administrator
ADMIN_EMAIL=

# Long random string. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
SESSION_HOURS=12
PORTAL_SESSION_HOURS=8             # client area: sign clients out after this many hours

# ---------------- Database ----------------
# PostgreSQL (e.g. Neon): when set, the CRM stores everything there and DB_FILE is ignored.
# Example: postgresql://user:password@host/dbname?sslmode=require&channel_binding=require
# Run only ONE server process per database (each process keeps the data in memory).
DATABASE_URL=
DB_SCHEMA=public                  # Postgres schema for the tables, e.g. "staging" to test without touching live data
# SQLite file, used only when DATABASE_URL is empty
DB_FILE=./db/crm.db               # use ./db/demo.db after "npm run demo"

# ---------------- Email (choose one provider) ----------------
# EMAIL_PROVIDER=smtp | sendgrid | brevo | resend
EMAIL_PROVIDER=
EMAIL_FROM=accounts@abselglobal.com
EMAIL_FROM_NAME=Absel Markets
EMAIL_REPLY_TO=support@abselmarkets.com
EMAIL_API_KEY=                   # for sendgrid / brevo / resend
SMTP_HOST=                       # for smtp, e.g. smtp.office365.com or smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false                # true for port 465
SMTP_USER=
SMTP_PASS=

# ---------------- WhatsApp Business Cloud API (Meta) ----------------
WHATSAPP_TOKEN=                  # permanent system-user access token
WHATSAPP_PHONE_NUMBER_ID=        # from Meta > WhatsApp > API setup
WHATSAPP_API_VERSION=v21.0
WHATSAPP_VERIFY_TOKEN=           # any random string; paste the same value in Meta's webhook settings
WHATSAPP_APP_SECRET=             # Meta app secret, used to verify webhook signatures

# ---------------- Lead sources (marketing) ----------------
# Generic lead API for Zapier / Make / partner sites: POST /api/inbound/lead with header X-Api-Key
LEAD_API_KEY=
# Meta (Facebook / Instagram) Lead Ads → webhook URL https://your-domain/webhooks/meta-leads, field "leadgen"
META_VERIFY_TOKEN=               # any random string; paste the same value in the Meta app webhook settings
META_APP_SECRET=                 # verifies webhook signatures
META_PAGE_TOKEN=                 # Page access token with leads_retrieval permission
META_API_VERSION=v21.0
META_DEFAULT_COUNTRY=            # used when the lead form has no country question, e.g. Nigeria
# Google Ads lead form extensions → webhook URL https://your-domain/webhooks/google-leads, key below
GOOGLE_LEAD_KEY=
GOOGLE_DEFAULT_COUNTRY=

# ---------------- Phone system (sales) ----------------
# Without these, the Dial button opens the computer's softphone (tel: link, e.g. MicroSIP, Zoiper, 3CX app).
# Click-to-call: the CRM asks your PBX to ring the agent's extension, then the client.
# Placeholders: {extension} {number} (+2348012345678) {number_digits} (2348012345678)
TELEPHONY_CLICK_URL=             # e.g. https://pbx.example.com/api/dial?ext={extension}&to={number_digits}
TELEPHONY_CLICK_METHOD=GET       # or POST
TELEPHONY_CLICK_BODY=            # POST body template, default {"extension":"{extension}","number":"{number}"}
TELEPHONY_AUTH_HEADER=           # e.g. Bearer abc123 (sent as the Authorization header)
# Call events and recordings: POST https://your-domain/webhooks/calls with header X-Webhook-Token
TELEPHONY_WEBHOOK_TOKEN=

# ---------------- Crypto payments: B2BINPAY (optional) ----------------
# Get these in the B2BINPAY back office (API access). Sandbox and live have separate keys.
B2BINPAY_API_URL=https://v3.api-sandbox.b2binpay.com   # live: https://sv.v3.api.b2binpay.com
B2BINPAY_API_KEY=                 # <-- FILL (sandbox key first)
B2BINPAY_API_SECRET=              # <-- FILL
B2BINPAY_CALLBACK_SECRET=         # <-- FILL (callback secret from B2BINPAY)
B2BINPAY_WALLET_ID=               # optional default; usually set per payment method in Client area settings
B2BINPAY_TIME_LIMIT=3600          # seconds a payment address stays reserved
B2BINPAY_INACCURACY=1             # USDT tolerance, e.g. 100 USDT accepts 99–101

# --- Card deposits: CyrafaPay Visa / Mastercard hosted checkout ---------------
# Values come from the Cyrafa merchant panel / Cyrafa support. Never paste them in chat or email.
# Test (QA): https://merchant-visamaster-qa.cyrafa.com/api/v1/cp/psp/visa-master
# Live:      https://merchant-visamaster.cyrafa.com/api/v1/cp/psp/visa-master
CYRAFA_API_URL=https://merchant-visamaster-qa.cyrafa.com/api/v1/cp/psp/visa-master
CYRAFA_PARTNER_ID=
CYRAFA_MERCHANT_ID=
CYRAFA_PARTNER_SECRET=            # signs the payment notifications (webhooks)
CYRAFA_CURRENCY=AED               # Cyrafa charges in AED only
CYRAFA_FX_RATE=3.6725             # AED per 1 USD used to convert deposits (AED is pegged at 3.6725)
